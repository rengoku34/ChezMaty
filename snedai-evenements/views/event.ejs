<%- include('partials/header') %>
<div class="page-head">
  <%- include('partials/breadcrumb', { items: [{ label: 'Événements', href: '/' }, { label: event.titre }] }) %>
  <% if (isAdmin) { %><a class="btn btn-small btn-secondary" href="/admin/evenements/<%= event.id %>/modifier"><%- include('partials/icon', { name: 'edit' }) %> Modifier</a><% } %>
</div>

<div class="event-layout">
  <article class="event-main">
    <% if (event.has_photo) { %><img src="/evenements/<%= event.id %>/photo" alt="Photo de l’événement" class="detail-photo"><% } %>
    <div class="detail-body">
      <h1><%= event.titre %></h1>

      <ul class="infos">
        <% if (event.debut) { %>
          <li>
            <%- include('partials/icon', { name: 'calendar' }) %>
            <div><strong><%= format.eventDate(event.debut).replace(/ à .*/, '') %></strong><span><%= format.eventHours(event.debut, event.fin) %></span></div>
          </li>
        <% } %>
        <% if (event.lieu) { %>
          <li><%- include('partials/icon', { name: 'pin' }) %><div><strong><%= event.lieu %></strong><span>Lieu</span></div></li>
        <% } %>
      </ul>

      <% if (agenda) { %>
        <div class="agenda">
          <span>Ajouter à mon agenda</span>
          <a class="btn btn-small btn-secondary" href="<%= agenda.google %>" target="_blank" rel="noopener">Google Agenda</a>
          <a class="btn btn-small btn-secondary" href="<%= agenda.outlook %>" target="_blank" rel="noopener">Outlook</a>
          <a class="btn btn-small btn-secondary" href="<%= agenda.ics %>">iPhone / autre</a>
        </div>
      <% } %>

      <h2 class="section-title">À propos</h2>
      <div class="description"><%= event.description %></div>
    </div>
  </article>

  <aside class="event-side">
    <% if (event.termine_at) { %>
      <div class="side-card side-done">
        <span class="status status-done">Terminé</span>
        <h2>Cet événement est terminé</h2>
        <% if (participation && participation.scanne_at) { %>
          <p>Votre présence a été validée à l’entrée. Merci d’avoir participé.</p>
        <% } else { %>
          <p>Retrouvez les prochains événements sur la page d’accueil.</p>
        <% } %>
      </div>

    <% } else if (participation && participation.scanne_at) { %>
      <div class="ticket ticket-ok">
        <div class="ticket-head"><%- include('partials/icon', { name: 'check' }) %> Présence validée</div>
        <div class="ticket-body">
          <p class="ticket-name"><%= user.prenom %> <%= user.nom %></p>
          <p class="ticket-sub"><%= user.filiale %></p>
          <p class="ticket-note">Votre venue a été confirmée à l’entrée le <%= format.timestamp(participation.scanne_at) %>. Bon événement !</p>
        </div>
      </div>

    <% } else if (participation) { %>
      <div class="ticket">
        <div class="ticket-head"><%- include('partials/icon', { name: 'ticket' }) %> Billet d’entrée</div>
        <div class="ticket-body">
          <p class="ticket-name"><%= user.prenom %> <%= user.nom %></p>
          <p class="ticket-sub"><%= user.filiale %></p>
          <img class="ticket-qr" src="<%= qr %>" alt="Votre QR code personnel" width="240" height="240">
          <p class="ticket-note">Présentez ce QR code à l’agent d’accueil, sur votre téléphone ou imprimé.</p>
          <a class="btn btn-secondary btn-block" href="/evenements/<%= event.id %>/qr.png"><%- include('partials/icon', { name: 'download' }) %> Télécharger mon QR code</a>
        </div>
        <form class="ticket-foot" method="post" action="/evenements/<%= event.id %>/annuler" data-confirm="Annuler votre participation ? Votre QR code ne sera plus valable.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link danger" type="submit">Je ne pourrai finalement pas venir</button>
        </form>
      </div>

    <% } else { %>
      <div class="side-card">
        <h2>Serez-vous présent(e) ?</h2>
        <p>Confirmez votre venue : vous recevrez aussitôt votre billet avec un QR code personnel, à présenter à l’entrée.</p>
        <form method="post" action="/evenements/<%= event.id %>/participer">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-big btn-block" type="submit"><%- include('partials/icon', { name: 'check' }) %> Je serai présent(e)</button>
        </form>
      </div>
    <% } %>
  </aside>
</div>
<%- include('partials/footer') %>
