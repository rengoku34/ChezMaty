<%- include('partials/header') %>
<section class="scan" data-csrf="<%= csrfToken %>">
  <h1>Scanner les QR codes</h1>
  <p class="hint">Avec la machine de scan : laissez cette page ouverte et scannez, la présence est enregistrée tout de suite (le curseur reste toujours dans le champ). Sans machine, utilisez la caméra.</p>

  <form id="scan-form" class="scan-form" autocomplete="off">
    <input id="scan-input" name="code" placeholder="Scannez un QR code…" autofocus autocomplete="off" autocapitalize="none" spellcheck="false">
    <button class="btn" type="submit">Valider</button>
  </form>
  <label class="checkbox scan-option"><input type="checkbox" id="machine-mode"> Mode machine de scan (ne pas ouvrir le clavier de l’écran)</label>

  <div id="scan-result" class="scan-result" aria-live="assertive" hidden></div>

  <div class="card">
    <button id="camera-toggle" class="btn btn-secondary" type="button"><%- include('partials/icon', { name: 'camera' }) %> Utiliser la caméra</button>
    <div id="camera" class="camera"></div>
  </div>

  <h2>Derniers scans</h2>
  <ul id="scan-history" class="scan-history"></ul>
</section>
<script src="/static/vendor/html5-qrcode.min.js" defer></script>
<script src="/static/js/scan.js?v=<%= assetVersion %>" defer></script>
<%- include('partials/footer') %>
