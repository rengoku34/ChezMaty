<%- include('partials/header') %>
<section class="auth-wrap">
  <%# Deux formulaires côte à côte ; un volet coloré glisse de l'un à l'autre (sur mobile, un seul est affiché). %>
  <div id="auth-container" class="auth-container <%= onglet === 'inscription' ? 'right-panel-active' : '' %>">

    <div class="auth-form-container sign-up-container">
      <form method="post" action="/inscription" class="auth-form">
        <h1>Créer mon compte</h1>
        <p class="hint">Votre adresse e-mail sera celle de votre compte Google, choisie à l’étape suivante.</p>
        <% if (error && onglet === 'inscription') { %><div class="alert alert-error"><%= error %></div><% } %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="row">
          <input name="nom" required maxlength="100" autocomplete="family-name" placeholder="Nom" aria-label="Nom" value="<%= values.nom || '' %>">
          <input name="prenom" required maxlength="100" autocomplete="given-name" placeholder="Prénom" aria-label="Prénom" value="<%= values.prenom || '' %>">
        </div>
        <% if (filiales.length) { %>
          <select name="filiale" required aria-label="Filiale">
            <option value="">Filiale…</option>
            <% filiales.forEach((f) => { %><option <%= values.filiale === f ? 'selected' : '' %>><%= f %></option><% }) %>
          </select>
        <% } else { %>
          <input name="filiale" required maxlength="100" placeholder="Filiale" aria-label="Filiale" value="<%= values.filiale || '' %>">
        <% } %>
        <input type="password" name="password" required minlength="8" autocomplete="new-password" placeholder="Mot de passe (8 caractères min.)" aria-label="Mot de passe">
        <input type="password" name="password_confirmation" required minlength="8" autocomplete="new-password" placeholder="Confirmer le mot de passe" aria-label="Confirmer le mot de passe">
        <button type="submit" class="btn btn-google" <%= googleEnabled ? '' : 'disabled' %>>
          <span class="g">G</span> Créer mon compte avec Google
        </button>
        <p class="auth-switch">Déjà un compte ? <a href="/connexion" data-auth="login">Se connecter</a></p>
      </form>
    </div>

    <div class="auth-form-container sign-in-container">
      <form method="post" action="/connexion" class="auth-form">
        <h1>Se connecter</h1>
        <p class="hint">Bon retour parmi nous !</p>
        <% if (error && onglet !== 'inscription') { %><div class="alert alert-error"><%= error %></div><% } %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="email" name="email" required autocomplete="email" placeholder="Adresse e-mail" aria-label="Adresse e-mail" value="<%= values.email || '' %>">
        <input type="password" name="password" required autocomplete="current-password" placeholder="Mot de passe" aria-label="Mot de passe">
        <button type="submit" class="btn">Se connecter</button>
        <% if (googleEnabled) { %>
          <div class="separator"><span>ou</span></div>
          <a class="btn btn-google" href="/auth/google"><span class="g">G</span> Se connecter avec Google</a>
        <% } %>
        <p class="auth-switch">Pas encore de compte ? <a href="/connexion?onglet=inscription" data-auth="register">Créer mon compte</a></p>
      </form>
    </div>

    <div class="overlay-container" aria-hidden="true">
      <div class="overlay">
        <div class="overlay-panel overlay-left">
          <%- include('partials/logo', { size: 'big' }) %>
          <h2>Bon retour !</h2>
          <p>Vous avez déjà un compte ? Connectez-vous pour retrouver les événements et votre QR code.</p>
          <a class="btn btn-ghost" href="/connexion" data-auth="login" tabindex="-1">Se connecter</a>
        </div>
        <div class="overlay-panel overlay-right">
          <%- include('partials/logo', { size: 'big' }) %>
          <h2>Bienvenue chez SNEDAI</h2>
          <p>Créez votre compte pour être informé des événements et confirmer votre présence.</p>
          <a class="btn btn-ghost" href="/connexion?onglet=inscription" data-auth="register" tabindex="-1">Créer mon compte</a>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
