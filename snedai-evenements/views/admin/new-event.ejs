<%- include('../partials/header') %>
<div class="page-head">
  <%- include('../partials/breadcrumb', { items: event
    ? [{ label: 'Tableau de bord', href: `/admin/tableau-de-bord?evenement=${event.id}` }, { label: 'Modifier l’événement' }]
    : [{ label: 'Tableau de bord', href: '/admin/tableau-de-bord' }, { label: 'Publier un événement' }] }) %>
</div>
<section class="card narrow">
  <h1><%= event ? 'Modifier l’événement' : 'Publier un événement' %></h1>
  <% if (event) { %>
    <p class="hint">Les inscrits ne sont pas prévenus à nouveau, et les QR codes déjà envoyés restent valables.</p>
  <% } else { %>
    <p class="hint">Dès la publication, tous les inscrits reçoivent un e-mail avec le lien pour confirmer leur présence.</p>
  <% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= event ? `/admin/evenements/${event.id}/modifier` : '/admin/evenements' %>" enctype="multipart/form-data" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Sujet<input name="titre" required maxlength="150" value="<%= values.titre || '' %>"></label>
    <label>Description<textarea name="description" required rows="7" maxlength="5000"><%= values.description || '' %></textarea></label>
    <% if (event && event.has_photo) { %>
      <div class="current-photo">
        <img src="/evenements/<%= event.id %>/photo" alt="Photo actuelle">
        <label class="checkbox"><input type="checkbox" name="supprimer_photo" value="1"> Supprimer la photo actuelle</label>
      </div>
    <% } %>
    <label><%= event && event.has_photo ? 'Remplacer la photo' : 'Photo' %> (JPG, PNG, WEBP – 3 Mo max)<input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/gif"></label>
    <div class="row">
      <label>Début<input type="datetime-local" name="debut" value="<%= values.debut || '' %>"></label>
      <label>Fin<input type="datetime-local" name="fin" value="<%= values.fin || '' %>"></label>
    </div>
    <label>Lieu<input name="lieu" maxlength="200" value="<%= values.lieu || '' %>" placeholder="Ex. : Siège SNEDAI, salle de conférence"></label>
    <% if (event) { %>
      <div class="actions">
        <button type="submit" class="btn">Enregistrer les modifications</button>
        <a class="btn btn-secondary" href="/admin/tableau-de-bord?evenement=<%= event.id %>">Annuler</a>
      </div>
    <% } else { %>
      <button type="submit" class="btn">Publier et prévenir les inscrits</button>
    <% } %>
  </form>
</section>
<%- include('../partials/footer') %>
