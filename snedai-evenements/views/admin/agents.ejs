<%- include('../partials/header') %>
<section class="card">
  <h1>Agents de scan</h1>
  <p class="hint">Les agents d’accueil peuvent seulement ouvrir la page « Scanner » pour valider les QR codes à l’entrée. Ils ne voient ni le tableau de bord, ni les listes, ni l’export Excel.</p>
  <% if (!users.length) { %>
    <p class="empty">Aucun inscrit pour le moment.</p>
  <% } else { %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Nom</th><th>Prénom</th><th>E-mail</th><th>Filiale</th><th>Agent de scan</th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr>
            <td><%= u.nom %></td><td><%= u.prenom %></td><td><%= u.email %></td><td><%= u.filiale %></td>
            <td>
              <form method="post" action="/admin/agents/<%= u.id %>" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="agent" value="<%= u.is_agent ? '0' : '1' %>">
                <button class="btn btn-small <%= u.is_agent ? 'btn-secondary' : '' %>" type="submit"><%= u.is_agent ? 'Retirer' : 'Nommer agent' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
