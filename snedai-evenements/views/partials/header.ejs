<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Événements SNEDAI</title>
  <link rel="stylesheet" href="/static/css/style.css?v=<%= assetVersion %>">
  <script src="/static/js/app.js?v=<%= assetVersion %>" defer></script>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/"><%- include('logo') %> <span class="brand-text"><%= logoUrl ? 'Événements' : 'Événements SNEDAI' %></span></a>
  <% if (user) { %>
  <nav class="nav">
    <a href="/" class="<%= path === '/' ? 'active' : '' %>">Événements</a>
    <% if (isAgent) { %><a href="/scan" class="<%= path.startsWith('/scan') ? 'active' : '' %>">Scanner</a><% } %>
    <% if (isAdmin) { %>
      <a href="/admin/evenements/nouveau" class="<%= path === '/admin/evenements/nouveau' ? 'active' : '' %>">Publier</a>
      <a href="/admin/tableau-de-bord" class="<%= path === '/admin/tableau-de-bord' ? 'active' : '' %>">Tableau de bord</a>
      <a href="/admin/agents" class="<%= path === '/admin/agents' ? 'active' : '' %>">Agents</a>
    <% } %>
    <form method="post" action="/deconnexion" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link">Déconnexion (<%= user.prenom %>)</button>
    </form>
  </nav>
  <% } %>
</header>
<main class="container">
<% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.message %></div><% } %>
