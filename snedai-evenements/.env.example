# Copier ce fichier en .env puis remplir les valeurs (ne jamais publier le .env)

PORT=3000
# Adresse publique du site, sans / final (sert aux liens des e-mails et au retour Google)
APP_URL=http://localhost:3000
# Chaîne longue et aléatoire (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Seule(s) adresse(s) e-mail ayant les droits d'administration (publier, tableaux de bord, Excel, terminer).
# Ce sont les vôtres : personne d'autre n'aura ces droits. Plusieurs adresses : séparées par des virgules.
ADMIN_EMAILS=votre.adresse@gmail.com

# Liste des filiales proposées dans le formulaire d'inscription, séparées par des ;
FILIALES=SNEDAI Groupe;SNEDAI Technologies;OSIA;Autre

# Base PostgreSQL (gratuite chez Neon : neon.com). Copier la « connection string ».
DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require

# Client OAuth Google (console.cloud.google.com > API et services > Identifiants)
# URI de redirection autorisée à déclarer : <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi des e-mails (recommandé) : AgentMail, gratuit jusqu'à environ 3 000 e-mails par mois (agentmail.to)
# Clé API et adresse de la boîte créée dans la console AgentMail.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=snedai-evenements@agentmail.to

# Autre possibilité : clé API Brevo (gratuit, 300 e-mails/jour : brevo.com)
BREVO_API_KEY=
# Expéditeur (adresse validée dans Brevo > Expéditeurs)
MAIL_FROM="Événements SNEDAI <votre.adresse@gmail.com>"

# Alternative à Brevo : serveur SMTP (ne fonctionne pas sur l'offre gratuite de Render)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Fuseau horaire d'affichage des dates
TIMEZONE=Africa/Abidjan
