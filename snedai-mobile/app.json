{
  "expo": {
    "name": "Événements SNEDAI",
    "slug": "snedai-evenements",
    "scheme": "snedai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#eef0f5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ci.snedai.evenements",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ci.snedai.evenements",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#26246a"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner les QR codes d’entrée des participants.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://snedai-evenements.onrender.com"
    }
  }
}
