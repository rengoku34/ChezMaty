# Configuration locale Chez Maty. Copier ce fichier vers .env.
APP_NAME=Chez Maty
APP_ENV=development
DEBUG=false

# Generer une cle aleatoire avant de lancer l'API (voir les commandes de l'etape 1).
SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_LOCALE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SQLite en developpement. En production, remplacer par une URL MySQL.
DATABASE_URL=sqlite:///./chezmaty.db

# Autoriser uniquement les origines locales utilisees pendant le developpement.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_URL=http://127.0.0.1:5500
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Stockage local des images en developpement.
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=5

# Paiement CinetPay : conserver les vrais identifiants uniquement dans .env (local) ou dans les variables privees Render.
PAYMENT_PROVIDER=cinetpay
PAYMENT_SANDBOX=true
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=


# Emails : configurer avec un fournisseur SMTP avant les essais d'envoi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Push Web : generer les cles VAPID avant d'activer les notifications push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@chezmaty.ci
